{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": ["typescript/**/*.ts", "*.json"]
  },
  "formatter": {
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noDuplicateTestHooks": "error"
      },
      "nursery": {
        "noFloatingPromises": "error",
        "useExhaustiveSwitchCases": {
          "level": "error",
          "options": {
            "requireExplicitCase": true
          }
        },
        "noExcessiveNestedBlocks": {
          "level": "error",
          "options": {
            "max": 4
          }
        }
      },
      "complexity": {
        "noExcessiveNestedTestSuites": "error"
      },
      "style": {
        "noUselessElse": "error",
        "noDoneCallback": "error",
        "noParameterAssign": {
          "level": "error",
          "options": {
            "propertyAssignment": "allow"
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["typescript/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**", "!@mcap/core", "!mediabunny", "!./**"],
                    "message": "Browser MCAP utilities depend on generic media libraries and local utilities, not consumer applications or UI frameworks."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
